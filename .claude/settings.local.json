{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:platform.openai.com)",
      "WebFetch(domain:styleinspo.vercel.app)",
      "WebFetch(domain:style-inspo-api-production.up.railway.app)",
      "WebFetch(domain:docs.dev.runwayml.com)",
      "WebFetch(domain:academy.runwayml.com)",
      "WebFetch(domain:help.runwayml.com)",
      "WebFetch(domain:runwayml.com)",
      "Bash(streamlit run:*)",
      "Bash(rq worker:*)",
      "Bash(STORAGE_TYPE=:*)",
      "Bash(STORAGE_TYPE=s3 python3:*)",
      "Bash(.claude/scripts/bash-command-validator.sh)",
      "WebFetch(domain:posthog.com)",
      "mcp__posthog__query-run",
      "mcp__posthog__docs-search",
      "Bash(aws s3 cp:*)",
      "WebFetch(domain:www.lennysnewsletter.com)",
      "WebFetch(domain:caseyaccidental.com)",
      "WebFetch(domain:www.fishmanafnewsletter.com)",
      "WebFetch(domain:www.intercom.com)",
      "Bash(env)",
      "mcp__plugin_playwright_playwright__browser_network_requests",
      "mcp__plugin_playwright_playwright__browser_console_messages",
      "Bash(echo:*)",
      "Bash(aws s3 ls:*)",
      "Bash(xargs:*)",
      "Skill(ralph-loop:ralph-loop)",
      "Bash(lsof:*)",
      "Bash(npm run:*)",
      "Bash(grep:*)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:every.to)",
      "WebFetch(domain:aws.amazon.com)",
      "Skill(daily-digest)",
      "Bash(claude mcp --help:*)",
      "Bash(claude --version:*)",
      "Bash(jq:*)",
      "Bash(while read line)",
      "Bash(do echo \"$#ine\")",
      "Bash(done)",
      "Bash(do len=$#ine if [ $len -lt 150 ])",
      "Bash(then echo \"[$len chars] $line\" fi done)",
      "Skill(run-local-dev)",
      "mcp__plugin_playwright_playwright__browser_resize",
      "WebFetch(domain:www.altadaily.com)",
      "WebFetch(domain:www.myindyx.com)",
      "Bash(pgrep:*)",
      "Bash(docker:*)",
      "Bash(pkill:*)",
      "WebFetch(domain:www.granola.ai)",
      "mcp__granola__list_meetings",
      "mcp__granola__get_meetings",
      "mcp__granola__get_meeting_transcript",
      "WebFetch(domain:www.twilio.com)",
      "Bash(sips:*)",
      "Bash(git -C /Users/peichin/Projects/style-inspo-api ls-files:*)",
      "Bash(twilio profiles:list:*)",
      "Bash(twilio api:core:messages:list:*)",
      "Bash(twilio profiles:use:*)",
      "Bash(while read id)",
      "Bash(do curl -s -X DELETE http://localhost:8000/api/wardrobe/testextract/items/$id done echo 'Cleaned up testextract wardrobe')",
      "Bash(/Users/peichin/Projects/style-inspo-api/backend/venv/bin/python:*)"
    ],
    "deny": [
      "Bash(gh:*)"
    ],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/bash-command-validator.sh",
            "timeout": 60,
            "statusMessage": "Validating bash command (git push: check untracked files | git commit: run smoke tests)"
          }
        ]
      }
    ]
  },
  "outputStyle": "default"
}

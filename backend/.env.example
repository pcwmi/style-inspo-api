# Environment variables for Style Inspo API
# Copy this file to .env and fill in your actual values

# OpenAI API key for outfit generation
OPENAI_API_KEY=your_openai_api_key_here

# Runway ML Configuration (for outfit visualization)
RUNWAY_API_KEY=your_runway_api_key_here
RUNWAY_MODEL_DESCRIPTOR=  # Optional default model descriptor (user-level descriptors take precedence)

# Anthropic API key (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API key (for Gemini models)
GOOGLE_API_KEY=your_google_api_key_here

# AWS S3 Configuration (for image storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
S3_BUCKET_NAME=your_s3_bucket_name
S3_REGION=us-east-2
STORAGE_TYPE=s3  # or "local" for local file storage

# Prompt version
PROMPT_VERSION=chain_of_thought_v1

# PostgreSQL Database (for user authentication)
DATABASE_URL=postgresql://user:password@host:5432/styleinspo

# JWT Secret (for session tokens)
JWT_SECRET=your_secure_random_secret_here

# Resend (for magic link emails)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Style Inspo <noreply@yourdomain.com>

# Frontend URL (for magic links)
FRONTEND_URL=https://styleinspo.vercel.app
